<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_space">

    <!-- Mandala background -->
    <com.cec.launcher.MandalaView
        android:id="@+id/mandalaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Frequency Clock -->
    <com.cec.launcher.FrequencyClockView
        android:id="@+id/frequencyClock"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <!-- Daily Intention -->
    <TextView
        android:id="@+id/dailyIntention"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:textColor="@color/text_luminous"
        android:textSize="15sp"
        android:fontFamily="sans-serif-light"
        android:lineSpacingExtra="4dp"
        android:alpha="0.88"
        app:layout_constraintTop_toBottomOf="@id/frequencyClock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Breathing Orb -->
    <com.cec.launcher.BreathingOrbView
        android:id="@+id/breathingOrb"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintTop_toBottomOf="@id/dailyIntention"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Settings gear -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_settings"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/text_luminous"
        android:alpha="0.7"
        android:contentDescription="Settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp" />

    <!-- Dim overlay for drawer -->
    <View
        android:id="@+id/drawerDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000011"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Guideline at 28% from top so drawer occupies ~72% of screen height -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/drawerGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.28" />

    <!-- App Drawer container -->
    <FrameLayout
        android:id="@+id/drawerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/drawerGuideline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FAB App Drawer -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAppDrawer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_apps"
        android:contentDescription="Open apps"
        app:tint="@color/text_luminous"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp"
        app:elevation="6dp"
        app:fabSize="normal" />

</androidx.constraintlayout.widget.ConstraintLayout>
